#!/bin/bash
# Dan Tech video tool.
#   ./dt render videos/<slug>/script.json   full pipeline: TTS → align → props → Remotion → mix → description
#   ./dt render <script> --from render      resume from a step (tts|align|props|render|mix|describe)
#   ./dt render <script> --new-voice        force a fresh TTS take (otherwise unchanged narration reuses .cache/tts)
#   ./dt render <script> --tts edge         free Edge TTS (no key); --tts gemini forces Gemini. Default: key -> Gemini, no key -> Edge
#     Edge options: --voice vi-VN-HoaiMyNeural --rate +10% --pitch +0Hz --volume +0%   (or script.json "tts": {...})
#   ./dt fetch-music                        download the Commons music library
#   ./dt doctor                             check this machine has everything needed
#   ./dt setup                              install deps (venv, npm, whisper model, music); idempotent
set -e
cd "$(dirname "$0")"; ROOT=$(pwd)
# prefer the project venv (created by scripts/setup.sh) for every python3 call, including in child scripts
[ -x "$ROOT/.venv/bin/python3" ] && export PATH="$ROOT/.venv/bin:$PATH" && export VIRTUAL_ENV="$ROOT/.venv"
# load .env (GEMINI_API_KEY) without overriding variables already set in the shell
[ -f .env ] && [ -z "$GEMINI_API_KEY" ] && { set -a; . ./.env; set +a; }
cmd=$1; shift || true
case "$cmd" in
 fetch-music) python3 scripts/fetch_music.py ;;
 doctor) exec scripts/doctor.sh ;;
 setup) exec scripts/setup.sh ;;
 render)
  SCRIPT=$1; shift || true; FROM=tts; TTS_ARGS=()
  while [ $# -gt 0 ]; do case "$1" in
   --from) FROM=$2; shift 2 ;;
   --new-voice) export NEW_VOICE=1; shift ;;
   --tts|--voice|--rate|--pitch|--volume) [ $# -ge 2 ] || { echo "$1 needs a value"; exit 1; }; TTS_ARGS+=("$1=$2"); shift 2 ;;
   --tts=*|--voice=*|--rate=*|--pitch=*|--volume=*) TTS_ARGS+=("$1"); shift ;;
   *) echo "unknown option: $1"; exit 1 ;;
  esac; done
  [ -f "$SCRIPT" ] || { echo "script not found: $SCRIPT"; exit 1; }
  DIR=$(dirname "$SCRIPT"); OUT=$DIR/out; SLUG=$(basename "$DIR"); mkdir -p "$OUT"
  THEME=$(cd scripts && python3 -c "import json,sys;from common import theme_id;print(theme_id(json.load(open('$ROOT/$SCRIPT'))['theme']))")
  steps=(tts align props render mix describe); run=0
  for s in "${steps[@]}"; do [ "$s" = "$FROM" ] && run=1; [ $run = 1 ] || continue; echo "── $s"
   case $s in
    tts)    python3 scripts/tts.py "$SCRIPT" ${TTS_ARGS[@]+"${TTS_ARGS[@]}"} ;;
    align)  python3 scripts/align.py "$SCRIPT" ;;
    props)  python3 scripts/build_props.py "$SCRIPT" ;;
    render) (cd remotion && npx remotion render src/index.ts "$THEME" "$ROOT/$OUT/raw.mp4" --props="$ROOT/$OUT/props.json" --log=error)
            scripts/loudnorm.sh "$OUT/raw.mp4" "$OUT/voice_sfx.mp4" ;;
    mix)    python3 scripts/pick_music.py "$SCRIPT"
            eval "$(python3 -c "import json;m=json.load(open('$OUT/music.json'));p=json.load(open('$OUT/props.json'));print(f\"MF='{m['file']}';MS={m['start']};REL={m['rel']};FS={p['outro']['start']/30:.2f}\")")"
            REL=$REL FS=$FS scripts/mix_bgm.sh "$OUT/voice_sfx.mp4" "$MF" "$MS" "$OUT/$SLUG.mp4" "$OUT/stems"
            ffmpeg -v error -y -i "$OUT/voice_sfx.mp4" -vn -c:a pcm_s16le "$OUT/stems/voice_sfx.wav"
            python3 scripts/measure_vm.py "$OUT/stems/voice_sfx.wav" "$OUT/stems/music_ducked.wav" "$OUT/words.json" ;;
    describe) python3 scripts/describe.py "$SCRIPT" ;;
   esac; done
  echo "✓ $OUT/$SLUG.mp4" ;;
 *) sed -n 2,11p "$0"; exit 1 ;;
esac
